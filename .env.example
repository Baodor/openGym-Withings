# Kopieren nach .env – kein Secret in Git committen!
PUBLIC_URL=https://opengym-withings.home.glockb.de
TZ=Europe/Berlin
# Nur bei zusätzlichem VPN-Setup erweitern; keine VPS-Public-Forwarder freigeben.
ALLOWED_CIDRS=192.168.1.0/24,100.64.0.0/10
OPENGYM_INTERNAL_URL=http://opengym-api-1:3000
# Wird benötigt, falls dein bestehendes Compose-Netzwerk anders heißt.
OPENGYM_BACKEND_NETWORK=opengym_backend

# Persistenter SQLite-/Schlüssel-Speicher. Nie auf einen leeren Ordner umbiegen.
BRIDGE_DATA_HOST_PATH=/mnt/docker/appdata/opengym-withings
# BRIDGE_STORAGE_ID wird ausschließlich von scripts/storage_admin.py init/adopt
# in der LOKALEN .env ergänzt; niemals hier manuell vorbelegen.
